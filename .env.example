# ============================================================================
# Rumi Dental Care — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with real values.
# NEVER commit your actual .env file or real credentials to version control.
# ============================================================================

APP_NAME="Rumi Dental Care"
APP_ENV="development"
SECRET_KEY="replace-with-a-64-char-cryptographically-random-hex-secret-key"
CSRF_SECRET="replace-with-a-64-char-cryptographically-random-csrf-hmac-key"

# PostgreSQL Database Connections (SQLAlchemy 2.x + psycopg v3)
DATABASE_URL="postgresql+psycopg://postgres:YOUR_DB_PASSWORD_HERE@localhost:5432/rumi_dental"
TEST_DATABASE_URL="postgresql+psycopg://postgres:YOUR_DB_PASSWORD_HERE@localhost:5432/rumi_dental_test"

# Application URLs & CORS
FRONTEND_URL="http://127.0.0.1:5173"
BACKEND_URL="http://127.0.0.1:8000"
ALLOWED_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173"

# Private Storage for Confidential Clinical Documents & X-Rays
# Must reside outside any publicly served static directory
UPLOAD_STORAGE_PATH="./private_uploads"
MAX_UPLOAD_SIZE_MB=15

# Authentication & Security Settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Clinic Defaults
DEFAULT_CURRENCY="PKR"
CLINIC_TIMEZONE="Asia/Karachi"

# Optional Email / SMS Notification Provider Settings (Leave blank if not configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="muhammadhafizhassan228@gmail.com"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD_HERE"
SMTP_FROM_EMAIL="muhammadhafizhassan228@gmail.com"
CLINIC_WHATSAPP_NUMBER="+923102468080"
SMS_PROVIDER_URL=""
SMS_API_KEY=""
